<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Yönetim Paneli</title><link rel="stylesheet" href="/style.css"></head><body class="admin-body"><header class="admin-top"><div><span class="eyebrow dark">YÖNETİM PANELİ</span><h1><%= data.companyName %></h1></div><div class="admin-actions"><a class="btn ghost darkbtn" href="/" target="_blank">Siteyi Gör</a><form method="post" action="/admin/logout"><button class="btn primary">Çıkış</button></form></div></header><main class="admin-wrap"><% if(saved){ %><div class="alert success">Değişiklikler kaydedildi.</div><% } %>
<section class="panel"><h2>Genel İçerik</h2><form method="post" action="/admin/general" enctype="multipart/form-data" class="admin-form"><label>Firma adı<input name="companyName" value="<%= data.companyName %>"></label><div class="form-grid"><label>Slider başlığı<input name="heroTitle" value="<%= data.hero.title %>"></label><label>Slider görseli<input name="heroImage" type="file" accept="image/*"><small>Mevcut: <%= data.hero.image %></small></label></div><label>Slider açıklaması<textarea name="heroSubtitle"><%= data.hero.subtitle %></textarea></label><div class="form-grid"><label>Hakkımızda başlığı<input name="aboutTitle" value="<%= data.about.title %>"></label><label>Telefon<input name="phone" value="<%= data.contact.phone %>"></label></div><label>Hakkımızda metni<textarea name="aboutText"><%= data.about.text %></textarea></label><div class="form-grid"><label>E-posta<input name="email" value="<%= data.contact.email %>"></label><label>WhatsApp numarası<input name="whatsapp" value="<%= data.contact.whatsapp %>"></label></div><label>Adres<input name="address" value="<%= data.contact.address %>"></label><button class="btn primary">Genel Bilgileri Kaydet</button></form></section>
<section class="panel"><h2>Hizmet Kartları</h2><div class="admin-services"><% data.services.forEach((s,i)=>{ %><form method="post" action="/admin/service/<%= i %>" enctype="multipart/form-data" class="service-editor"><img src="<%= s.image %>"><label>Başlık<input name="title" value="<%= s.title %>"></label><label>Açıklama<textarea name="text"><%= s.text %></textarea></label><label>Yeni görsel<input name="serviceImage" type="file" accept="image/*"></label><button class="btn primary">Kartı Kaydet</button></form><% }) %></div></section></main></body></html>
